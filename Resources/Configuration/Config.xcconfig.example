// Configuration file for Surreal360 iOS
// Copy this file to Config.xcconfig and fill in your values
// DO NOT commit Config.xcconfig to version control

// Backend API Configuration
BACKEND_URL = https://your-backend.com

// Supabase Configuration
SUPABASE_URL = https://your-project.supabase.co
SUPABASE_ANON_KEY = your-supabase-anon-key-here

// App Configuration
APP_DISPLAY_NAME = Surreal360
BUNDLE_IDENTIFIER = com.surrealsimulations.surreal360

// Build Configuration
SWIFT_VERSION = 5.9
IPHONEOS_DEPLOYMENT_TARGET = 17.0
